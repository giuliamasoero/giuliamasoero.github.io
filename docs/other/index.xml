               /media/logo_avocetta_hu7276c90c6d6e1e61a6c85eb11f6bc7e2_12787_d2925a57e8cdcb61d9c9555213a27e69.webp 400w,
               /media/logo_avocetta_hu7276c90c6d6e1e61a6c85eb11f6bc7e2_12787_8c64331675968929d21f5c9e873d9c13.webp 760w,
               /media/logo_avocetta_hu7276c90c6d6e1e61a6c85eb11f6bc7e2_12787_1200x1200_fit_q75_h2_lanczos_3.webp 1200w&#34;
               src=&#34;/media/logo_avocetta_hu7276c90c6d6e1e61a6c85eb11f6bc7e2_12787_d2925a57e8cdcb61d9c9555213a27e69.webp&#34;
